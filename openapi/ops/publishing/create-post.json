{
  "openapi": "3.1.0",
  "info": {
    "title": "OmniMux Publishing — Create Post",
    "version": "official-only"
  },
  "servers": [
    {
      "url": "https://omnimux.ai"
    }
  ],
  "security": [
    {
      "accessToken": [],
      "userId": []
    }
  ],
  "paths": {
    "/api/social/v1/posts": {
      "post": {
        "operationId": "createPost",
        "summary": "Create Post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Replay must match both source and account set. X-Idempotency-Key is also accepted."
          }
        ],
        "responses": {
          "200": {
            "description": "Check success before reading data. Generic upstream errors may use HTTP 200 with success:false.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "provider": {
                              "type": "string",
                              "enum": [
                                "tiktok_direct"
                              ],
                              "description": "Required source identifier; currently only tiktok_direct is accepted.",
                              "example": "tiktok_direct"
                            },
                            "status": {
                              "type": "string",
                              "description": "A newly created post starts as submitted. An idempotent replay can return a later stored status."
                            },
                            "provider_post_id": {
                              "type": "string"
                            },
                            "content_preview": {
                              "type": "string"
                            },
                            "created_at": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "idempotency_key": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "provider",
                            "status"
                          ]
                        }
                      },
                      "required": [
                        "success",
                        "data"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "success",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing/unknown provider or invalid request. invalid-provider identifies a missing or unknown source.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "410": {
            "description": "Retired source identifier. provider-retired means the removed source can no longer be used; move the account to an official platform.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "Billing-related rejection where applicable; upstream failures may instead be wrapped as success:false.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Account ownership or access denied.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Account or post not found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Source or account-set conflict, or a structured TikTok account/policy rejection (scope missing, token invalid, posting banned, or publish restricted).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "upstream_code": {
                      "type": "string",
                      "description": "Sanitized TikTok upstream error code when available."
                    },
                    "upstream_log_id": {
                      "type": "string",
                      "description": "TikTok upstream log_id for support and debugging when available."
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                },
                "examples": {
                  "accountProviderMismatch": {
                    "summary": "The account belongs to a different source",
                    "value": {
                      "success": false,
                      "code": "account-provider-mismatch",
                      "message": "account-provider-mismatch"
                    }
                  },
                  "tiktokPublishScopeMissing": {
                    "summary": "TikTok account lacks a publishing scope",
                    "value": {
                      "success": false,
                      "code": "SOCIAL_TIKTOK_SCOPE_MISSING",
                      "message": "tiktok account has no publishing scope; reconnect after video.upload or video.publish is granted"
                    }
                  },
                  "tiktokPublishRestricted": {
                    "summary": "TikTok rejected posting due to account or app limit",
                    "value": {
                      "success": false,
                      "code": "SOCIAL_TIKTOK_PUBLISH_RESTRICTED",
                      "message": "TikTok posting limit reached",
                      "upstream_code": "spam_risk_too_many_posts",
                      "upstream_log_id": "20261124090000ABCDEF"
                    }
                  },
                  "tiktokPostingBanned": {
                    "summary": "TikTok account is restricted from posting",
                    "value": {
                      "success": false,
                      "code": "SOCIAL_TIKTOK_POSTING_BANNED",
                      "message": "TikTok account is restricted from posting",
                      "upstream_code": "spam_risk_user_banned_from_posting",
                      "upstream_log_id": "20261124090001ABCDEF"
                    }
                  },
                  "tiktokTokenInvalid": {
                    "summary": "TikTok OAuth token expired or revoked",
                    "value": {
                      "success": false,
                      "code": "SOCIAL_TIKTOK_TOKEN_INVALID",
                      "message": "TikTok authorization expired or invalid; please reconnect account",
                      "upstream_code": "access_token_invalid",
                      "upstream_log_id": "20261124090002ABCDEF"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "TikTok upstream rate limit exceeded; retry with backoff.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "upstream_code": {
                      "type": "string"
                    },
                    "upstream_log_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "code"
                  ]
                },
                "example": {
                  "success": false,
                  "code": "SOCIAL_TIKTOK_RATE_LIMITED",
                  "message": "TikTok rate limit reached; please retry later",
                  "upstream_code": "rate_limit_exceeded",
                  "upstream_log_id": "20261124090003ABCDEF"
                }
              }
            }
          },
          "502": {
            "description": "Other TikTok upstream error; structured code and upstream_log_id are passed through when available.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "upstream_code": {
                      "type": "string"
                    },
                    "upstream_log_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "code"
                  ]
                },
                "example": {
                  "success": false,
                  "code": "SOCIAL_TIKTOK_UPSTREAM_ERROR",
                  "message": "TikTok upstream request failed",
                  "upstream_code": "internal_error",
                  "upstream_log_id": "20261124090004ABCDEF"
                }
              }
            }
          },
          "503": {
            "description": "Requested provider is disabled or not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "tiktok_direct"
                    ],
                    "description": "Required source identifier; currently only tiktok_direct is accepted."
                  },
                  "account_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "description": "Owned OmniMux account IDs, all belonging to the requested source. Official publishing supports one account."
                  },
                  "content": {
                    "type": "string",
                    "description": "Optional caption for Direct Post, or fallback description for photo drafts when tiktok_options.description is omitted. Ignored for video drafts."
                  },
                  "media_items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "description": "The public_url returned by Media Presign. Upload the file successfully before submitting the post. Image URLs are wrapped through the gateway's signed verified-domain proxy before calling TikTok."
                        },
                        "type": {
                          "type": "string",
                          "description": "Optional media type, such as video or image."
                        },
                        "content_type": {
                          "type": "string",
                          "description": "Optional MIME type (for example image/jpeg, image/webp, or video/mp4). Useful when the image URL has no file extension."
                        }
                      },
                      "required": [
                        "url"
                      ]
                    },
                    "description": "Required TikTok media. Both Draft upload (video.upload) and Direct Post (video.publish) accept either one video or a JPEG/WebP photo carousel (no mixed photo+video). Hosted OmniMux supports 1 to 35 images per photo post (TikTok Photo API maximum); self-hosted deployments default to 10 items and can be configured up to 35.",
                    "minItems": 1
                  },
                  "tiktok_options": {
                    "type": "object",
                    "description": "TikTok metadata and publishing options. Photo draft uploads (video.upload, MEDIA_UPLOAD) accept title, description, photo_cover_index, and is_aigc and never forward Direct Post privacy, interaction, or disclosure fields. Video draft uploads ignore this object. Direct Post (video.publish) uses the privacy, interaction, disclosure, and photo fields.",
                    "properties": {
                      "title": {
                        "type": "string",
                        "description": "Optional photo carousel title (used for photo drafts and photo Direct Posts)."
                      },
                      "description": {
                        "type": "string",
                        "description": "Optional photo carousel description (falls back to top-level description or content when omitted)."
                      },
                      "photo_cover_index": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Optional 0-based index of the cover image in media_items (explicit 0 is preserved; must be less than the number of photos)."
                      },
                      "is_aigc": {
                        "type": "boolean",
                        "description": "Optional AI-generated content disclosure flag for photo drafts and photo Direct Posts (explicit false is preserved)."
                      },
                      "privacy_level": {
                        "type": "string",
                        "enum": [
                          "PUBLIC_TO_EVERYONE",
                          "MUTUAL_FOLLOW_FRIENDS",
                          "FOLLOWER_OF_CREATOR",
                          "SELF_ONLY"
                        ],
                        "default": "SELF_ONLY",
                        "description": "Direct Post (video.publish) only. Select a visibility level available to the TikTok account; not sent in draft mode."
                      },
                      "allow_comment": {
                        "type": "boolean",
                        "description": "Direct Post (video.publish) only. Allow comments; not sent in draft mode."
                      },
                      "allow_duet": {
                        "type": "boolean",
                        "description": "Direct Post (video.publish) only. Allow Duet on video posts; not sent in draft mode."
                      },
                      "allow_stitch": {
                        "type": "boolean",
                        "description": "Direct Post (video.publish) only. Allow Stitch on video posts; not sent in draft mode."
                      },
                      "commercial_content": {
                        "type": "boolean",
                        "description": "Direct Post (video.publish) only. Enable commercial disclosure. When true, also set your_brand or branded_content to true; not sent in draft mode."
                      },
                      "your_brand": {
                        "type": "boolean",
                        "description": "Direct Post (video.publish) only. Disclose promotion of your own brand; not sent in draft mode."
                      },
                      "branded_content": {
                        "type": "boolean",
                        "description": "Direct Post (video.publish) only. Disclose promotion of a third-party brand. When true, choose a privacy level other than SELF_ONLY; not sent in draft mode."
                      },
                      "music_usage_confirmed": {
                        "type": "boolean",
                        "description": "Direct Post (video.publish) only. Indicates confirmation of music usage. The gateway rejects an explicit false in Direct Post mode; not sent in draft mode."
                      }
                    }
                  },
                  "title": {
                    "type": "string",
                    "description": "Optional compatibility alias for tiktok_options.title on photo posts."
                  },
                  "description": {
                    "type": "string",
                    "description": "Optional compatibility alias for tiktok_options.description on photo posts."
                  },
                  "photo_cover_index": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Optional compatibility alias for tiktok_options.photo_cover_index on photo posts."
                  },
                  "is_aigc": {
                    "type": "boolean",
                    "description": "Optional compatibility alias for tiktok_options.is_aigc on photo posts."
                  }
                },
                "required": [
                  "provider",
                  "account_ids",
                  "media_items"
                ]
              },
              "example": {
                "provider": "tiktok_direct",
                "account_ids": [
                  123
                ],
                "media_items": [
                  {
                    "url": "https://example.invalid/clip.mp4",
                    "type": "video"
                  }
                ]
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "curl",
            "label": "cURL",
            "source": "curl --request POST \\\n  --url \"https://omnimux.ai/api/social/v1/posts\" \\\n  --header 'Authorization: Bearer <user-access-token>' \\\n  --header 'New-Api-User: <user-id>' \\\n  --header 'Content-Type: application/json' \\\n  --data '{\"provider\":\"tiktok_direct\",\"account_ids\":[123],\"media_items\":[{\"url\":\"https://example.invalid/clip.mp4\",\"type\":\"video\"}]}'"
          }
        ],
        "description": "After validation, the gateway submits the request to TikTok immediately. The account’s publishing capabilities determine the mode. Use Get Post to track the outcome."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "OmniMux user access token, not an sk- API key."
      },
      "userId": {
        "type": "apiKey",
        "in": "header",
        "name": "New-Api-User",
        "description": "Current authenticated user ID."
      }
    }
  }
}
