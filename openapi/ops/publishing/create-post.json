{
  "openapi": "3.1.0",
  "info": {
    "title": "OmniMux Publishing — Create Post",
    "version": "official-only"
  },
  "servers": [
    {
      "url": "https://omnimux.ai"
    }
  ],
  "security": [
    {
      "accessToken": [],
      "userId": []
    }
  ],
  "paths": {
    "/api/social/v1/posts": {
      "post": {
        "operationId": "createPost",
        "summary": "Create Post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Replay must match both source and account set. X-Idempotency-Key is also accepted."
          }
        ],
        "responses": {
          "200": {
            "description": "Check success before reading data. Generic upstream errors may use HTTP 200 with success:false.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "provider": {
                              "type": "string",
                              "enum": [
                                "tiktok_direct"
                              ],
                              "description": "Required source identifier; currently only tiktok_direct is accepted.",
                              "example": "tiktok_direct"
                            },
                            "status": {
                              "type": "string",
                              "description": "A newly created post starts as submitted. An idempotent replay can return a later stored status."
                            },
                            "provider_post_id": {
                              "type": "string"
                            },
                            "content_preview": {
                              "type": "string"
                            },
                            "created_at": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "idempotency_key": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "provider",
                            "status"
                          ]
                        }
                      },
                      "required": [
                        "success",
                        "data"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "success",
                        "message"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing/unknown provider or invalid request. invalid-provider identifies a missing or unknown source.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "410": {
            "description": "Retired source identifier. provider-retired means the removed source can no longer be used; move the account to an official platform.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "Billing-related rejection where applicable; upstream failures may instead be wrapped as success:false.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Account ownership or access denied.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Account or post not found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Source or account-set conflict, or the TikTok account lacks both publishing scopes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                },
                "examples": {
                  "accountProviderMismatch": {
                    "summary": "The account belongs to a different source",
                    "value": {
                      "success": false,
                      "code": "account-provider-mismatch",
                      "message": "account-provider-mismatch"
                    }
                  },
                  "tiktokPublishScopeMissing": {
                    "summary": "TikTok account lacks a publishing scope",
                    "value": {
                      "success": false,
                      "code": "SOCIAL_TIKTOK_SCOPE_MISSING",
                      "message": "tiktok account has no publishing scope; reconnect after video.upload or video.publish is granted"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Requested provider is disabled or not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "tiktok_direct"
                    ],
                    "description": "Required source identifier; currently only tiktok_direct is accepted."
                  },
                  "account_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "description": "Owned OmniMux account IDs, all belonging to the requested source. Official publishing supports one account."
                  },
                  "content": {
                    "type": "string",
                    "description": "Optional caption for Direct Post. Draft upload ignores this field."
                  },
                  "media_items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "description": "The public_url returned by Media Presign. Upload the file successfully before submitting the post."
                        },
                        "type": {
                          "type": "string",
                          "description": "Optional media type, such as video or image."
                        }
                      },
                      "required": [
                        "url"
                      ]
                    },
                    "description": "Required TikTok media. Draft upload accepts exactly one video. Direct Post accepts one video or a set of photos.",
                    "minItems": 1
                  },
                  "tiktok_options": {
                    "type": "object",
                    "description": "Privacy, interaction and disclosure settings for accounts with video.publish. Draft upload ignores this object.",
                    "properties": {
                      "privacy_level": {
                        "type": "string",
                        "enum": [
                          "PUBLIC_TO_EVERYONE",
                          "MUTUAL_FOLLOW_FRIENDS",
                          "FOLLOWER_OF_CREATOR",
                          "SELF_ONLY"
                        ],
                        "default": "SELF_ONLY",
                        "description": "Select a visibility level available to the TikTok account."
                      },
                      "allow_comment": {
                        "type": "boolean",
                        "description": "Allow comments."
                      },
                      "allow_duet": {
                        "type": "boolean",
                        "description": "Allow Duet on video posts."
                      },
                      "allow_stitch": {
                        "type": "boolean",
                        "description": "Allow Stitch on video posts."
                      },
                      "commercial_content": {
                        "type": "boolean",
                        "description": "Enable commercial disclosure. When true, also set your_brand or branded_content to true."
                      },
                      "your_brand": {
                        "type": "boolean",
                        "description": "Disclose promotion of your own brand."
                      },
                      "branded_content": {
                        "type": "boolean",
                        "description": "Disclose promotion of a third-party brand. When true, choose a privacy level other than SELF_ONLY."
                      },
                      "music_usage_confirmed": {
                        "type": "boolean",
                        "description": "Indicates confirmation of music usage. The gateway rejects an explicit false."
                      }
                    }
                  }
                },
                "required": [
                  "provider",
                  "account_ids",
                  "media_items"
                ]
              },
              "example": {
                "provider": "tiktok_direct",
                "account_ids": [
                  123
                ],
                "media_items": [
                  {
                    "url": "https://example.invalid/clip.mp4",
                    "type": "video"
                  }
                ]
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "curl",
            "label": "cURL",
            "source": "curl --request POST \\\n  --url \"https://omnimux.ai/api/social/v1/posts\" \\\n  --header 'Authorization: Bearer <user-access-token>' \\\n  --header 'New-Api-User: <user-id>' \\\n  --header 'Content-Type: application/json' \\\n  --data '{\"provider\":\"tiktok_direct\",\"account_ids\":[123],\"media_items\":[{\"url\":\"https://example.invalid/clip.mp4\",\"type\":\"video\"}]}'"
          }
        ],
        "description": "After validation, the gateway submits the request to TikTok immediately. The account’s publishing capabilities determine the mode. Use Get Post to track the outcome."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "accessToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "OmniMux user access token, not an sk- API key."
      },
      "userId": {
        "type": "apiKey",
        "in": "header",
        "name": "New-Api-User",
        "description": "Current authenticated user ID."
      }
    }
  }
}
