{
  "openapi": "3.1.0",
  "info": {
    "title": "Gemini · Native multimodal text",
    "version": "1.0.0",
    "description": "Native Gemini content requests with system instructions, media input, text and structured output on OmniMux."
  },
  "servers": [
    {
      "url": "https://api.omnimux.ai"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/v1beta/models/{model}:generateContent": {
      "post": {
        "operationId": "generateGeminiNativeText",
        "summary": "Gemini native text generation",
        "description": "Use native systemInstruction and contents.parts. Send text and media as separate parts of user content. Responses contain text, structured data or function-call requests.",
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "gemini-4-argon"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NativeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Native response; inspect finishReason and usageMetadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/InsufficientQuota"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1beta/models/{model}:streamGenerateContent": {
      "post": {
        "operationId": "streamGeminiNativeText",
        "summary": "Gemini native streaming text generation",
        "description": "Use the same native request body with alt=sse. Read complete data events and inspect final finishReason and usageMetadata.",
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "gemini-4-argon"
              ]
            }
          },
          {
            "name": "alt",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "sse"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NativeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE data events containing native response chunks",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "data: {\"candidates\":[{\"content\":{\"role\":\"model\",\"parts\":[{\"text\":\"Hello\"}]}}]}\n\ndata: {\"candidates\":[{\"finishReason\":\"STOP\"}],\"usageMetadata\":{\"promptTokenCount\":74,\"candidatesTokenCount\":6,\"thoughtsTokenCount\":115,\"totalTokenCount\":195}}\n\n"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/InsufficientQuota"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "OmniMux API token"
      }
    },
    "schemas": {
      "TextPart": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      },
      "InlinePart": {
        "type": "object",
        "required": [
          "inlineData"
        ],
        "properties": {
          "inlineData": {
            "type": "object",
            "required": [
              "mimeType",
              "data"
            ],
            "properties": {
              "mimeType": {
                "type": "string",
                "enum": [
                  "image/png",
                  "video/mp4",
                  "application/pdf"
                ]
              },
              "data": {
                "type": "string",
                "contentEncoding": "base64",
                "description": "Complete original media bytes encoded as base64, without a data-URL prefix"
              }
            }
          }
        }
      },
      "NativeContent": {
        "type": "object",
        "required": [
          "parts"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user"
            ]
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TextPart"
                },
                {
                  "$ref": "#/components/schemas/InlinePart"
                }
              ]
            }
          }
        }
      },
      "NativeRequest": {
        "type": "object",
        "required": [
          "contents"
        ],
        "properties": {
          "systemInstruction": {
            "type": "object",
            "required": [
              "parts"
            ],
            "properties": {
              "parts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TextPart"
                }
              }
            },
            "description": "Task framework and scope; media content is data, not a higher-priority instruction"
          },
          "contents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/NativeContent"
            }
          },
          "generationConfig": {
            "type": "object",
            "properties": {
              "thinkingConfig": {
                "type": "object",
                "properties": {
                  "thinkingLevel": {
                    "type": "string",
                    "enum": [
                      "low"
                    ],
                    "description": "This reference documents low thinking effort."
                  }
                }
              },
              "maxOutputTokens": {
                "type": "integer",
                "minimum": 1,
                "example": 2048,
                "description": "Combined thinking and visible-output budget. This example value is not a model maximum."
              },
              "responseMimeType": {
                "type": "string",
                "enum": [
                  "application/json"
                ]
              },
              "responseSchema": {
                "type": "object",
                "description": "Native Schema object for structured text, used with responseMimeType=application/json."
              }
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "functionDeclarations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "parameters"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "parameters": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            },
            "description": "Function declarations for a single-turn function-call response. The returned functionCall asks the client to execute the function; it does not run the function."
          },
          "toolConfig": {
            "type": "object",
            "properties": {
              "functionCallingConfig": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "ANY"
                    ]
                  },
                  "allowedFunctionNames": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "example": {
          "systemInstruction": {
            "parts": [
              {
                "text": "Respond concisely."
              }
            ]
          },
          "contents": [
            {
              "role": "user",
              "parts": [
                {
                  "text": "Hello."
                }
              ]
            }
          ],
          "generationConfig": {
            "maxOutputTokens": 2048
          }
        }
      },
      "NativeResponse": {
        "type": "object",
        "properties": {
          "modelVersion": {
            "type": "string",
            "description": "Supplier-reported model version; not independent backend identity proof"
          },
          "responseId": {
            "type": "string"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "finishReason": {
                  "type": "string"
                },
                "content": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string"
                    },
                    "parts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string"
                          },
                          "thought": {
                            "type": "boolean"
                          },
                          "functionCall": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "args": {
                                "type": "object"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "usageMetadata": {
            "$ref": "#/components/schemas/UsageMetadata"
          }
        }
      },
      "UsageMetadata": {
        "type": "object",
        "properties": {
          "promptTokenCount": {
            "type": "integer",
            "minimum": 0
          },
          "toolUsePromptTokenCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Additional reported tool-use input, counted in total input once"
          },
          "candidatesTokenCount": {
            "type": "integer",
            "minimum": 0
          },
          "thoughtsTokenCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Reported thinking, counted in output once"
          },
          "cachedContentTokenCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Cached input subset, not additional input"
          },
          "totalTokenCount": {
            "type": "integer",
            "minimum": 0
          },
          "promptTokensDetails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModalityUsage"
            }
          },
          "toolUsePromptTokensDetails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModalityUsage"
            }
          }
        },
        "description": "Optional fields remain absent when not supplied; absent is not an explicit zero. Do not add modality breakdowns again or treat cumulative stream snapshots as separate charges."
      },
      "ModalityUsage": {
        "type": "object",
        "properties": {
          "modality": {
            "type": "string"
          },
          "tokenCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid or unsupported request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid OmniMux API token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InsufficientQuota": {
        "description": "Insufficient available quota",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Request/model access is not allowed; this native surface may also return insufficient_user_quota as HTTP 403. Inspect the error code and message rather than assuming a permission problem.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Requested resource or model is unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit reached",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalError": {
        "description": "Gateway error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UpstreamError": {
        "description": "Upstream error or incomplete upstream result",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "No available accepted route",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
