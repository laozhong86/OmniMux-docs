{
  "openapi": "3.0.3",
  "info": {
    "title": "GPT Image · 图像生成",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://api.omnimux.ai"
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "summary": "GPT Image · 图像生成",
        "operationId": "generateGPTImage",
        "description": "GPT Image 标准生图与既有独立型号的调用规范。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "title": "标准服务",
                    "type": "object",
                    "required": [
                      "model",
                      "prompt"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "model": {
                        "type": "string",
                        "enum": [
                          "gpt-image-2.5"
                        ],
                        "default": "gpt-image-2.5"
                      },
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192,
                        "description": "完整提示词须同时不超过 8192 个 Unicode 码点、16384 个 UTF-8 字节和本服务按 o200k_base 计数的 5000 个词元，空白也计入上限，且不得全为空白。这是标准服务的运营限制，不是官方独立 Flare / Sunburst 型号的 32000 字符上限；本地词元计数不代表供应商最终计费量，也不保证单次采购成本上限。超限在预留费用和发送供应商请求前明确拒绝，不截断、压缩或替换。"
                      },
                      "n": {
                        "type": "integer",
                        "enum": [
                          1
                        ],
                        "default": 1
                      },
                      "size": {
                        "type": "string",
                        "enum": [
                          "1:1",
                          "2:3",
                          "3:2",
                          "3:4",
                          "4:3",
                          "9:16",
                          "16:9",
                          "1024x1024",
                          "1024x1536",
                          "1536x1024",
                          "1024x1360",
                          "1360x1024",
                          "1088x1920",
                          "1920x1088",
                          ""
                        ],
                        "default": "1024x1024",
                        "description": "仅支持所列七种画幅和精确像素。省略或空字符串使用 1024x1024；3:4 与 4:3 是近似画幅，旧 1024x1365 和 1365x1024 不再接受。size 和 aspect_ratio 同时提供时必须对应相同像素。"
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "1:1",
                          "2:3",
                          "3:2",
                          "3:4",
                          "4:3",
                          "9:16",
                          "16:9",
                          "1024x1024",
                          "1024x1536",
                          "1536x1024",
                          "1024x1360",
                          "1360x1024",
                          "1088x1920",
                          "1920x1088",
                          ""
                        ],
                        "description": "仅支持所列七种画幅和精确像素。省略或空字符串使用 1024x1024；3:4 与 4:3 是近似画幅，旧 1024x1365 和 1365x1024 不再接受。size 和 aspect_ratio 同时提供时必须对应相同像素。"
                      },
                      "quality": {
                        "type": "string",
                        "enum": [
                          "medium"
