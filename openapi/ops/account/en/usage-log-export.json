{
  "openapi": "3.1.0",
  "info": {
    "title": "Export My Usage Logs",
    "version": "1.0.0",
    "description": "Stream the authenticated user’s visible logs; verify the terminal success record."
  },
  "servers": [
    {
      "url": "https://omnimux.ai"
    }
  ],
  "paths": {
    "/api/log/self/export": {
      "get": {
        "operationId": "exportOwnUsageLogs",
        "summary": "Export My Usage Logs",
        "description": "Stream the authenticated user’s visible logs; verify the terminal success record.",
        "security": [
          {
            "UserAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Log type; 0 includes all types.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "start_timestamp",
            "in": "query",
            "required": false,
            "description": "Start as Unix seconds. Omission uses the configured maximum range before the effective end.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "end_timestamp",
            "in": "query",
            "required": false,
            "description": "End as Unix seconds. Omission uses now; future times are capped at now for the range check.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "model_name",
            "in": "query",
            "required": false,
            "description": "Model-name filter.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "token_name",
            "in": "query",
            "required": false,
            "description": "Gateway-key name filter.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "group",
            "in": "query",
            "required": false,
            "description": "Request-group filter.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "request_id",
            "in": "query",
            "required": false,
            "description": "Gateway request-ID filter.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "upstream_request_id",
            "in": "query",
            "required": false,
            "description": "Upstream request-ID filter.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Export stream, or a business rejection before streaming. HTTP 200 alone does not prove completion.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "no-store"
              }
            },
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "description": "One log object per line; the last line is a success/message/data.count result. A later failure can emit success:false; a missing terminal result also means incomplete export."
                },
                "example": "{\"id\":1,\"user_id\":42,\"created_at\":1791979200,\"type\":2,\"content\":\"\",\"username\":\"example-user\",\"token_name\":\"example-key\",\"model_name\":\"\",\"quota\":500,\"prompt_tokens\":10,\"completion_tokens\":5,\"use_time\":1,\"is_stream\":false,\"channel\":0,\"channel_name\":\"\",\"token_id\":1,\"group\":\"\",\"ip\":\"\",\"request_id\":\"example-request-id\",\"other\":\"{}\"}\n{\"success\":true,\"message\":\"\",\"data\":{\"count\":1}}\n"
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportResult"
                },
                "example": {
                  "success": false,
                  "message": "Another log export is running. Try again after it finishes."
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid user credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                },
                "example": {
                  "success": false,
                  "code": "AUTH_UNAUTHORIZED",
                  "message": "Invalid user credential"
                }
              }
            }
          },
          "403": {
            "description": "The user credential lacks permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                },
                "example": {
                  "success": false,
                  "code": "ACCESS_TOKEN_SCOPE_DENIED",
                  "message": "Permission denied"
                }
              }
            }
          },
          "500": {
            "description": "Internal authentication error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                },
                "example": {
                  "success": false,
                  "code": "AUTH_INTERNAL_ERROR",
                  "message": "Internal authentication error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "UserAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "user access token",
        "description": "User access token with usage:read, not an sk- generation key. A dashboard login session is also supported."
      }
    },
    "schemas": {
      "ExportResult": {
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "message_key": {
            "type": "string",
            "description": "Optional localization key."
          },
          "message_params": {
            "type": "object",
            "additionalProperties": true
          },
          "data": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "AuthError": {
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
