{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OmniMux",
  "description": "Unified AI gateway documentation — OpenAI-compatible APIs for chat, images, video, and more.",
  "colors": {
    "primary": "#C8F135",
    "light": "#D4F75A",
    "dark": "#9BC422"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://geminix.cc/dashboard"
  },
  "api": {
    "openapi": [
      "openapi/relay.json"
    ],
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript",
        "go"
      ],
      "defaults": "required",
      "autogenerate": true
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "cn",
        "default": true,
        "groups": [
          {
            "group": "开始使用",
            "pages": [
              "cn/index",
              "cn/quickstart"
            ]
          },
          {
            "group": "指南",
            "pages": [
              "cn/guides/authentication",
              "cn/guides/base-url",
              "cn/guides/models"
            ]
          },
          {
            "group": "API 参考",
            "openapi": "openapi/relay.json",
            "pages": [
              "cn/api-reference/overview"
            ]
          }
        ]
      },
      {
        "language": "en",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "en/index",
              "en/quickstart"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "en/guides/authentication",
              "en/guides/base-url",
              "en/guides/models"
            ]
          },
          {
            "group": "API reference",
            "openapi": "openapi/relay.json",
            "pages": [
              "en/api-reference/overview"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Console",
          "href": "https://geminix.cc/dashboard",
          "icon": "gauge-high"
        },
        {
          "anchor": "Status",
          "href": "https://geminix.cc/status",
          "icon": "heart-pulse"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@geminix.cc"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://geminix.cc/dashboard"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/laozhong86/OmniMux",
      "website": "https://geminix.cc/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "seo": {
    "metatags": {
      "og:site_name": "OmniMux Docs"
    }
  }
}
