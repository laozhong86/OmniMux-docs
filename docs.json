{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OmniMux",
  "description": "Social media operations infrastructure for agents — API, CLI, Skill, and MCP. Console omnimux.ai · API api.omnimux.ai",
  "colors": {
    "primary": "#C8F135",
    "light": "#D4F75A",
    "dark": "#9BC422"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://omnimux.ai/dashboard"
  },
  "api": {
    "openapi": [
      "openapi/relay.json"
    ],
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript",
        "go"
      ],
      "defaults": "required",
      "autogenerate": true
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "cn",
        "default": true,
        "tabs": [
          {
            "tab": "用户指南",
